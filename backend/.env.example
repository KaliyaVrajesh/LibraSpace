# LibraSpace Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ======================================================
# Flask Environment
# ======================================================
FLASK_ENV=development
FLASK_APP=manage:app
LOG_LEVEL=INFO

# ======================================================
# Database (local development — PostgreSQL via Docker)
# ======================================================
DATABASE_URL=postgresql://libraspace:libraspace_dev_pass@localhost:5432/libraspace_dev
TEST_DATABASE_URL=postgresql://libraspace:libraspace_dev_pass@localhost:5432/libraspace_test

# ======================================================
# Security Keys — CHANGE THESE before deploying!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# ======================================================
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_KEY_32_CHARS
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_JWT_SECRET_KEY_32_CHARS

# ======================================================
# Library Configuration
# ======================================================
LIBRARY_TIMEZONE=Asia/Kolkata
LIBRARY_OPEN_HOUR=8
LIBRARY_CLOSE_HOUR=22
MAX_BOOKING_HOURS=4
MIN_BOOKING_MINUTES=30

# ======================================================
# CORS — frontend origin(s)
# ======================================================
# Comma-separated list for multiple origins
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ======================================================
# Port
# ======================================================
PORT=5000

# ======================================================
# AWS Production (only required for cloud deployment)
# Leave empty for local development.
# ======================================================
# AWS_DEFAULT_REGION=us-east-1
# DB_SECRET_ARN=arn:aws:secretsmanager:...
# APP_SECRET_NAME=libraspace/production/app-secrets
# ALB_DNS_NAME=libraspace-alb-...us-east-1.elb.amazonaws.com
# FRONTEND_URL=https://yourdomain.com
