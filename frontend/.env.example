# LibraSpace Frontend — Environment Configuration
# Copy to .env for local development.

# API base URL — leave empty to use Vite's proxy (recommended for local dev)
# VITE_API_BASE_URL=

# For production deployment, set this to the ALB URL or your domain:
# VITE_API_BASE_URL=https://your-alb-dns.us-east-1.elb.amazonaws.com/api
